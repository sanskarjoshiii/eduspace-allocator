    "cloudinary": "2.11.0",
    "clsx": "2.1.1",
    "leaflet": "1.9.4",
    "lucide-react": "1.58.0",
    "ml-kmeans": "7.0.1",
    "mongoose": "8.24.5",
    "next": "16.4.2",
    "next-auth": "5.0.0-beta.32",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.90.0",
