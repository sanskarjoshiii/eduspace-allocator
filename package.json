    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "mongodb-memory-server": "11.3.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
