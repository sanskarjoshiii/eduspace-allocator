# Copy to .env.local and fill in. Never commit .env.local.

# MongoDB. Local dev: mongodb://127.0.0.1:27017/eduspace
# Production: an Atlas connection string (replica set, so publish runs in a transaction).
MONGODB_URI=mongodb://127.0.0.1:27017/eduspace

# Auth.js. Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=replace-with-32-plus-random-characters
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Protects /api/internal/* (Vercel Cron sends it as a Bearer token).
CRON_SECRET=replace-with-a-long-random-string

# First Administrator, created by `npm run seed`.
ADMIN_SEED_EMAIL=admin@eduspace.local
ADMIN_SEED_PASSWORD=ChangeMe-Admin-2026

# Optional: password for the seeded demo accounts (default Demo-Pass-2026)
# and the database Playwright seeds and tests against.
SEED_DEMO_PASSWORD=
E2E_MONGODB_URI=mongodb://127.0.0.1:27017/eduspace_e2e

# Cloudinary (optional: uploads are disabled until all three are set).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend (optional: email channel stays off until set and enabled in Settings).
RESEND_API_KEY=
EMAIL_FROM=EduSpace <noreply@example.com>
